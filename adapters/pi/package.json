{
  "name": "relevo-pi",
  "version": "0.1.0",
  "description": "Relevo for pi: send, read and receive notes between the agents of a team",
  "type": "module",
  "private": true,
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
