# Caddy in front of Relevo (optional: `relevo serve --tls` speaks HTTPS itself, see
# docs/install.md): HTTPS with a certificate Caddy gets and renews by itself, client timeouts
# like Relevo's own and its body limit, idle connections to Relevo closed before Relevo closes
# them, and plain HTTP to Relevo on loopback. Replace relevo.example.com with your name; its DNS
# must point at this machine, and ports 80 and 443 must reach it (for the certificate). For a name only your office network
# resolves, add `tls internal` inside the site block: Caddy then uses its own CA, which each
# teammate's machine must trust.
#
# Try it:  caddy run --config Caddyfile     Check it:  caddy validate --config Caddyfile
#
# Joining a Caddyfile that already has sites: the block below holds global options, which must be
# the first block of the file and can appear only once. Merge its `servers` part into the global
# block at the top there, and append only the site block. Its timeouts apply to every site.

{
	servers {
		timeouts {
			# A slow or idle client cannot hold a connection forever.
			read_header 10s
			read_body 30s
			# A waiting inbox request (`wait` up to 60 s) answers only when something is new
			# or the time runs out: leave it room.
			write 90s
			idle 2m
		}
	}
}

relevo.example.com {
	# Relevo refuses bodies over 400 KiB itself (413); refuse them here, before they cross.
	request_body {
		max_size 400KiB
	}

	reverse_proxy 127.0.0.1:7878 {
		transport http {
			dial_timeout 5s
			# The answer to a waiting inbox starts after up to 60 s.
			response_header_timeout 75s
			# Close idle connections to Relevo before Relevo does (75 s; Caddy's default is
			# 2 minutes): one reused just as Relevo closes it fails, and a send that cannot be
			# replayed comes back as a 502.
			keepalive 60s
		}
	}
}
