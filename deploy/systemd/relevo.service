# Relevo server, as a systemd *user* unit: it runs as the owner's user, needs no root, and
# listens on loopback only, in plain HTTP. For teammates, turn on HTTPS in Relevo itself with a
# drop-in (Environment=RELEVO_TLS=true and RELEVO_ADDR=0.0.0.0:7878), or put a reverse proxy
# that terminates TLS in front (see docs/install.md). Installed by deploy/install.sh into
# ~/.config/systemd/user/. Change settings with `systemctl --user edit relevo`, not here.
[Unit]
Description=Relevo server (notes between teammates' agents)
# Give up after 5 failed starts within a minute (a database from an older version, say) instead
# of restarting forever; `systemctl --user reset-failed relevo` clears it.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
ExecStart=%h/.local/bin/relevo serve
Environment=RELEVO_DB=%h/.local/share/relevo/relevo.db
# The key that encrypts note text and thread titles, made at the first start, kept apart from the
# database and its backups: back it up on its own (see docs/install.md, part 5).
Environment=RELEVO_KEY_FILE=%h/.config/relevo/server.key
Environment=RELEVO_ADDR=127.0.0.1:7878
Environment=RUST_LOG=info
# Plain log lines in the journal (stdout and stderr go there): `journalctl --user -u relevo`.
Environment=NO_COLOR=1
StandardOutput=journal
StandardError=journal
# SIGTERM (the default) ends the server at once. That is safe: SQLite commits are atomic and
# durable, and a send cut off before its answer is retried by the adapters with its idempotency
# key. Waiting inbox requests (up to 60 s) are not waited for.
Restart=on-failure
RestartSec=5

# Limits and sandbox. The data directory is the only place it may write, and the directory of its
# key, where it makes the key at its first start (deploy/install.sh creates it; `-`: a unit
# without it still starts, and the server says it cannot make the key).
# Room for 1,024 connections that have not been authenticated yet, each holding at most a 16 KiB
# request head and its TLS buffers (about 40 KiB in all). A body (up to 400 KiB) is read only
# after its token is checked.
MemoryMax=128M
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=%h/.local/share/relevo -%h/.config/relevo
PrivateTmp=yes
# These need no namespaces, so they hold even where the mount sandbox above cannot be set up
# (see "Sandbox" in docs/install.md). AF_NETLINK only reads the machine's addresses (glibc's
# getifaddrs() needs it): without it, the certificate `serve --tls` makes has none of them.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
